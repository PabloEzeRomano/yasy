# API key de Resend (https://resend.com/api-keys).
# Sin esta variable, en desarrollo la ficha se imprime en la consola en vez de enviarse.
RESEND_API_KEY=

# Quién recibe cada ficha completada.
FICHA_TO_EMAIL=aventuraadiario@gmail.com

# Remitente. "onboarding@resend.dev" solo sirve para pruebas y solo entrega
# al email dueño de la cuenta de Resend. Para producción verificá un dominio
# en Resend y usá algo como: YASY <ficha@tudominio.com>
FICHA_FROM_EMAIL=YASY <onboarding@resend.dev>
